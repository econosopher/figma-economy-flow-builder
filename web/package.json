{
  "name": "economy-flow-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types",
    "deploy:staging": "npm run build && wrangler deploy --env staging",
    "deploy:production": "npm run build && wrangler deploy --env production",
    "presets:generate": "node scripts/generate-presets.mjs",
    "prebuild": "npm run presets:generate",
    "pretest": "npm run presets:generate",
    "predev": "npm run presets:generate"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "1.4.0",
    "@fontsource/inter": "^5.3.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@supabase/supabase-js": "^2.116.0",
    "@xyflow/react": "^12.11.6",
    "agents": "0.23.0",
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.8",
    "@cloudflare/workers-types": "^5.20260911.1",
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.1"
  }
}
