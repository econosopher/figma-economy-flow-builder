  "research": {
    "presetId": "monopoly_go",
    "revision": "2026-09-14.1",
    "category": "Mobile",
    "summary": "Rolls drive board growth and sticker collection, with rewards returning rolls to play.",
    "scope": "Persistent board, landmark and sticker loops; generic recurring rewards and purchases, not a particular album.",
    "checkedAt": "2026-09-14",
    "limitations": [
      "Album announcement is a dated example of the reward structure, not the current album. No album names, pack odds, trade limits or vault prices are assumed.",
      "Qualitative resource flows, not a balance simulation. Prices, odds and reward quantities are intentionally omitted. Sources were reviewed on the checked date; this is desk research, not a claim of live playtesting."
    ],
