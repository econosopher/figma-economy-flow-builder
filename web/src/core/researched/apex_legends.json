  "research": {
    "presetId": "apex_legends",
    "revision": "2026-09-14.1",
    "category": "PC / console",
    "summary": "Play unlocks Legends and rank; separate currencies fund cosmetic collection.",
    "scope": "Account progression, Ranked, split-based Battle Pass and enduring cosmetic currencies; no event-specific packs or current reward quantities.",
    "checkedAt": "2026-09-14",
    "limitations": [
      "Pack contents are random and region-dependent. No odds, guaranteed shard schedule, prices or season-specific rewards are assumed.",
      "Legend unlocks add playable options; cosmetics do not imply stronger gameplay stats. Paid pass eligibility is separate from earning pass progress.",
      "Ranked Points are a score with tier-dependent costs, not a shop currency.",
      "Qualitative resource flows, not a balance simulation. Prices, odds and reward quantities are intentionally omitted. Sources were reviewed on the checked date; this is desk research, not a claim of live playtesting."
    ],
