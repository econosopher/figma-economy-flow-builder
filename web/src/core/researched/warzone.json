  "research": {
    "presetId": "warzone",
    "revision": "2026-09-14.1",
    "category": "PC / console",
    "summary": "Match cash buys tactical tools; persistent XP and COD Points drive different loops.",
    "scope": "Standard Battle Royale and Black Ops 7-era persistent progression. Core mechanics, not a map-specific or limited-time mode.",
    "checkedAt": "2026-09-14",
    "limitations": [
      "The tactical guide is from the Modern Warfare III era and is used for enduring cash/Buy Station structure only. Maps, buy prices and temporary modes are excluded.",
      "Cash and purchased match equipment do not carry into the next standard Battle Royale match. COD Points do not convert into match cash.",
      "Warzone-compatible unlocks only. Some prestige rewards require the premium game; store blueprints are not represented as purely visual because they can grant weapon access.",
      "Qualitative resource flows, not a balance simulation. Prices, odds and reward quantities are intentionally omitted. Sources were reviewed on the checked date; this is desk research, not a claim of live playtesting."
    ],
