SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Base64 encoded 32 random bytes, used only by the server.
CREDENTIAL_ENCRYPTION_KEY=
SLACK_CLIENT_SECRET=
# Comma separated Supabase user UUIDs for gallery moderation.
ADMIN_USER_IDS=

# Direct Worker origin (never the Netlify gateway for authenticated traffic).
API_ORIGIN=http://127.0.0.1:8787
MCP_ENABLED=false
VIEW_HASH_KEY=
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
# PKCS#8 PEM, injected from a credential manager.
GITHUB_APP_PRIVATE_KEY=
