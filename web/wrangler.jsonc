{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "economy-flow-dev",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/.well-known/*"],
  },
  "browser": { "binding": "BROWSER" },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    "ENVIRONMENT": "development",
    "APP_URL": "http://127.0.0.1:5173",
    "SUPABASE_URL": "",
    "SUPABASE_ANON_KEY": "",
    "SLACK_CLIENT_ID": "",
    "GEMINI_MODEL": "gemini-3.5-flash",
    "OPENAI_MODEL": "gpt-5-mini",
    "CLAUDE_MODEL": "claude-sonnet-5",
  },
  "workflows": [
    {
      "binding": "RESEARCH",
      "name": "economy-flow-research-dev",
      "class_name": "ResearchWorkflow",
    },
    {
      "binding": "SLACK_SEND",
      "name": "economy-flow-slack-dev",
      "class_name": "SlackSendWorkflow",
    },
  ],
  "triggers": {
    "crons": ["17 * * * *"],
  },
  "env": {
    "staging": {
      "name": "economy-flow-staging",
      "browser": { "binding": "BROWSER" },
      "vars": {
        "ENVIRONMENT": "staging",
        "APP_URL": "https://economy-flow-staging.twig-transcripts-mcp.workers.dev",
        "API_ORIGIN": "https://economy-flow-staging.twig-transcripts-mcp.workers.dev",
        "GITHUB_APP_ID": "4938109",
        "GITHUB_INSTALLATION_ID": "161556596",
        "MCP_ENABLED": "true",
        "SUPABASE_URL": "https://qltklcguyebhhyieweme.supabase.co",
        "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InFsdGtsY2d1eWViaGh5aWV3ZW1lIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODkzNDgwMzksImV4cCI6MjEwNDkyNDAzOX0.eUQOTj_fxIIPOVk58IJ9gLG5YpQpwWnfFZ04Q0elOwA",
        "SLACK_CLIENT_ID": "",
        "GEMINI_MODEL": "gemini-3.5-flash",
        "OPENAI_MODEL": "gpt-5-mini",
        "CLAUDE_MODEL": "claude-sonnet-5",
      },
      "workflows": [
        {
          "binding": "RESEARCH",
          "name": "economy-flow-research-staging",
          "class_name": "ResearchWorkflow",
        },
        {
          "binding": "SLACK_SEND",
          "name": "economy-flow-slack-staging",
          "class_name": "SlackSendWorkflow",
        },
      ],
      "triggers": {
        "crons": ["17 * * * *"],
      },
      "ratelimits": [
        {
          "name": "EVENT_LIMIT",
          "namespace_id": "1000130901",
          "simple": {
            "limit": 60,
            "period": 60,
          },
        },
      ],
    },
    "production": {
      "name": "economy-flow",
      "browser": { "binding": "BROWSER" },
      "vars": {
        "ENVIRONMENT": "production",
        "APP_URL": "https://flow.gameeconomistconsulting.com",
        "API_ORIGIN": "https://economy-flow.twig-transcripts-mcp.workers.dev",
        "GITHUB_APP_ID": "4938109",
        "GITHUB_INSTALLATION_ID": "161556596",
        "MCP_ENABLED": "true",
        "SUPABASE_URL": "https://hwtdhoxaroivjseovbdm.supabase.co",
        "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imh3dGRob3hhcm9pdmpzZW92YmRtIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODkzNDgxOTksImV4cCI6MjEwNDkyNDE5OX0.UsOBDuQb3uCYPociCQa3gzXu0VPsXezpRz8ExM7lfCI",
        "SLACK_CLIENT_ID": "",
        "GEMINI_MODEL": "gemini-3.5-flash",
        "OPENAI_MODEL": "gpt-5-mini",
        "CLAUDE_MODEL": "claude-sonnet-5",
      },
      "workflows": [
        {
          "binding": "RESEARCH",
          "name": "economy-flow-research",
          "class_name": "ResearchWorkflow",
        },
        {
          "binding": "SLACK_SEND",
          "name": "economy-flow-slack",
          "class_name": "SlackSendWorkflow",
        },
      ],
      "triggers": {
        "crons": ["17 * * * *"],
      },
      "ratelimits": [
        {
          "name": "EVENT_LIMIT",
          "namespace_id": "1000130902",
          "simple": {
            "limit": 60,
            "period": 60,
          },
        },
      ],
    },
  },
  "ratelimits": [
    {
      "name": "EVENT_LIMIT",
      "namespace_id": "1000130900",
      "simple": {
        "limit": 60,
        "period": 60,
      },
    },
  ],
}
